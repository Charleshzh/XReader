# Auto-detect text files and normalize line endings to LF on commit
* text=auto

# Source files
*.rs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.html text eol=lf
*.sql text eol=lf

# Binary files (don't touch line endings)
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.icns binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.lock binary
